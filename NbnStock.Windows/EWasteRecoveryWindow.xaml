<Window x:Class="NbnStock.Windows.EWasteRecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk E-Waste Recovery" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ResourceKey=WindowBackgroundBrush}"
        Foreground="{DynamicResource ResourceKey=PrimaryTextBrush}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Bulk E-Waste Scanning" FontSize="22" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="Scan units below to stage them for e-waste recovery."
                       Foreground="{DynamicResource ResourceKey=SecondaryTextBrush}" Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Legacy Type (If not in DB):" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14" FontWeight="SemiBold"/>
                <ComboBox x:Name="ComboLegacyType" Width="200" Height="30" DisplayMemberPath="Name" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Scan Barcode:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14" FontWeight="SemiBold"/>
                <TextBox x:Name="InputScanner" Width="350" Height="30" FontSize="16" VerticalContentAlignment="Center" Padding="5,0" KeyDown="InputScanner_KeyDown"/>
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="BatchDataGrid" 
                  Grid.Row="1" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True" 
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource ResourceKey=DataGridBackgroundBrush}" 
                  RowBackground="{DynamicResource ResourceKey=DataGridRowBackgroundBrush}" 
                  AlternatingRowBackground="{DynamicResource ResourceKey=DataGridAlternateRowBrush}"
                  Foreground="{DynamicResource ResourceKey=PrimaryTextBrush}"
                  GridLinesVisibility="All" 
                  BorderBrush="{DynamicResource ResourceKey=BorderBrush}" 
                  BorderThickness="1"
                  Margin="0,0,0,15">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource ResourceKey=DataGridHeaderBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource ResourceKey=DataGridHeaderTextBrush}" />
                    <Setter Property="Padding" Value="10,5" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ResourceKey=DataGridGridLineBrush}" />
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Detection Type" Binding="{Binding Notes}" Width="*" />
                <DataGridTextColumn Header="Serial Number" Binding="{Binding SerialNumber}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="TxtTotalCount" Text="Total Units: 0" VerticalAlignment="Center" Margin="0,0,20,0" FontWeight="Bold"/>
            <Button Content="Clear Batch" Width="100" Height="30" Margin="0,0,10,0" Click="BtnClear_Click"/>
            <Button Content="Commit to E-Waste" Width="140" Height="30" Click="BtnCommit_Click"/>
        </StackPanel>

    </Grid>
</Window>