<Window x:Class="NbnStock.Windows.EWasteDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="E-Waste Management Pipeline" Height="600" Width="950"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="E-Waste Management Pipeline" FontSize="22" FontWeight="Bold" Margin="0,0,0,5"/>

        <TextBlock Grid.Row="1" Text="Select units below and progress them through the disposal stages." Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,15"/>

        <DataGrid x:Name="EwasteDataGrid" Grid.Row="2"
          AutoGenerateColumns="False" IsReadOnly="True"
          SelectionMode="Extended"
          Background="{DynamicResource DataGridBackgroundBrush}"
          Foreground="{DynamicResource PrimaryTextBrush}"
          RowBackground="{DynamicResource DataGridRowBackgroundBrush}"
          AlternatingRowBackground="{DynamicResource DataGridAlternateRowBrush}"
          GridLinesVisibility="All" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource DataGridHeaderBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource DataGridHeaderTextBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource DataGridGridLineBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="Padding" Value="8,5"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Current Status" Binding="{Binding Status}" Width="200" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="Serial Number" Binding="{Binding SerialNumber}" Width="250"/>
                <DataGridTextColumn Header="Date Logged" Binding="{Binding LastUpdatedUtc, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Log New E-Waste" Width="140" Height="30" Margin="0,0,20,0" Click="BtnLogNew_Click"/>
            <Button Content="Refresh List" Width="100" Height="30" Margin="0,0,20,0" Click="BtnRefresh_Click"/>
            <Button x:Name="BtnProgressStage" Content="Progress Selected to Next Stage" Width="220" Height="30" Click="BtnProgressStage_Click"/>
        </StackPanel>
    </Grid>
</Window>