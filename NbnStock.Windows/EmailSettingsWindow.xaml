<Window x:Class="NbnStock.Windows.EmailSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Email Integration Settings" Height="450" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <StackPanel Margin="20">
        <TextBlock Text="Email Configuration" FontSize="20" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBlock Text="Enter the connection details for O365 or Google Workspace. An App Password is required." 
                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,20" TextWrapping="Wrap"/>

        <TextBlock Text="IMAP Server (e.g., outlook.office365.com):" FontWeight="SemiBold"/>
        <TextBox x:Name="TxtServer" Margin="0,5,0,15" Padding="5" Height="25"/>

        <TextBlock Text="Port (Usually 993):" FontWeight="SemiBold"/>
        <TextBox x:Name="TxtPort" Margin="0,5,0,15" Padding="5" Height="25" Text="993"/>

        <CheckBox x:Name="ChkUseSsl" Content="Requires SSL/TLS" IsChecked="True" Margin="0,0,0,15" FontWeight="SemiBold"/>

        <TextBlock Text="Email Address:" FontWeight="SemiBold"/>
        <TextBox x:Name="TxtEmail" Margin="0,5,0,15" Padding="5" Height="25"/>

        <TextBlock Text="App Password:" FontWeight="SemiBold"/>
        <PasswordBox x:Name="TxtPassword" Margin="0,5,0,25" Padding="5" Height="25"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Height="30" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button Content="Save Settings" Width="120" Height="30" Click="BtnSave_Click"/>
        </StackPanel>
    </StackPanel>
</Window>