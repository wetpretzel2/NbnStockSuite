<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FFCCCCCC" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FF3A3A3A" />

    <!-- DataGrid -->
    <SolidColorBrush x:Key="DataGridBackgroundBrush" Color="#FF252526" />
    <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="#FF252526" />
    <SolidColorBrush x:Key="DataGridAlternateRowBrush" Color="#FF2D2D30" />
    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#FF333333" />
    <SolidColorBrush x:Key="DataGridHeaderTextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="DataGridGridLineBrush" Color="#FF444444" />

</ResourceDictionary>