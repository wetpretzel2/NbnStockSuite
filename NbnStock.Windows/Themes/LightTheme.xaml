<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF8F9FA" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF555555" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FFD0D0D0" />

    <!-- DataGrid -->
    <SolidColorBrush x:Key="DataGridBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="DataGridAlternateRowBrush" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#FFEAEAEA" />
    <SolidColorBrush x:Key="DataGridHeaderTextBrush" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="DataGridGridLineBrush" Color="#FFD6D6D6" />

</ResourceDictionary>