<Window x:Class="NbnStock.Windows.AddCustomItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Tech Supplied Item" Height="480" Width="350"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="New Tech Supplied Item" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Item Name *" Margin="0,0,0,5"/>
            <TextBox x:Name="InputName" Height="25" Margin="0,0,0,10" TextChanged="InputName_TextChanged"/>

            <TextBlock Text="Item Code *" Margin="0,0,0,5"/>
            <TextBox x:Name="InputCode" Height="25" Margin="0,0,0,10"/>

            <TextBlock Text="Category" Margin="0,0,0,5"/>
            <TextBox x:Name="InputCategory" Height="25" Margin="0,0,0,10" Text="Consumables"/>

            <TextBlock Text="Unit (e.g., Each, Pack, Length) *" Margin="0,0,0,5"/>
            <TextBox x:Name="InputUnit" Height="25" Margin="0,0,0,10" Text="Each"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Initial Qty" Margin="0,0,0,5"/>
                    <TextBox x:Name="InputQty" Height="25" Text="0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Min Stock" Margin="0,0,0,5"/>
                    <TextBox x:Name="InputMin" Height="25" Text="0"/>
                </StackPanel>
            </Grid>
            <CheckBox x:Name="ChkIsSerialised"
          Content="This item has individual serial numbers" 
          Foreground="{DynamicResource PrimaryTextBrush}" 
          Margin="0,10,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancel" Width="80" Height="30" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button Content="Save Item" Width="100" Height="30" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>