<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:NbnStock.Core.Models;assembly=NbnStock.Core"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
        x:Class="NbnStock.Desktop.MainWindow"
        Title="NbnStockSuite Desktop">

    <Grid RowDefinitions="Auto,Auto,*" Margin="16" RowSpacing="12">
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="NbnStockSuite Desktop"
                       FontSize="26"
                       FontWeight="SemiBold" />
            <TextBlock Text="M1 proof: Avalonia UI → NbnStock.Core → SQLite"
                       Opacity="0.75" />
        </StackPanel>

        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Text="Loading stock items..."
                   Opacity="0.75" />

        <Border Grid.Row="2"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8">
            <ScrollViewer>
                <ItemsControl x:Name="StockItemsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:StockItem">
                            <Grid ColumnDefinitions="120,*,120,120,120"
                                  Margin="0,4">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding ItemCode}"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Category}" />
                                <TextBlock Grid.Column="3"
                                           Text="{Binding Quantity}" />
                                <TextBlock Grid.Column="4"
                                           Text="{Binding SupplyType}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
