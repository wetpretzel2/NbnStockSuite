<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:NbnStock.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="1000"
        d:DesignHeight="650"
        x:Class="NbnStock.Desktop.MainWindow"
        x:DataType="viewModels:MainWindowViewModel"
        Title="NbnStockSuite Desktop">

    <Grid RowDefinitions="Auto,Auto,Auto,*"
          Margin="16"
          RowSpacing="12">

        <StackPanel Grid.Row="0"
                    Spacing="4">
            <TextBlock Text="NbnStockSuite Desktop"
                       FontSize="26"
                       FontWeight="SemiBold" />
            
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Opacity="0.75" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="8">
            <Button Content="Inventory"
                    Command="{Binding InventoryCommand}" />

            <Separator Margin="8,0" />

            <Button Content="Receive"
                    Command="{Binding ReceiveCommand}" />
            <Button Content="Consume" />

            <Separator Margin="8,0" />

            <Button Content="Bulk Receive" />
            <Button Content="Bulk Consume" />
            <Button Content="Refresh"
                    Command="{Binding RefreshCommand}" />

            <Separator Margin="8,0" />

            <Button Content="User Items" />
            <Button Content="Reports" />
            <Button Content="Settings" />

        </StackPanel>

        <ContentControl Grid.Row="3"
                        Content="{Binding CurrentPage}" />

    </Grid>

</Window>