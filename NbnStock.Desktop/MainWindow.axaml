<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:NbnStock.Core.Models;assembly=NbnStock.Core"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
        x:Class="NbnStock.Desktop.MainWindow"
        Title="NbnStockSuite Desktop">

    <Grid RowDefinitions="Auto,Auto,*" Margin="16" RowSpacing="12">
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="NbnStockSuite Desktop"
                       FontSize="26"
                       FontWeight="SemiBold" />
            <TextBlock Text="M1 proof: Avalonia UI → NbnStock.Core → SQLite"
                       Opacity="0.75" />
        </StackPanel>

        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Text="Loading stock items..."
                   Opacity="0.75" />

        <Border Grid.Row="2"
            BorderThickness="1"
                CornerRadius="8"
                Padding="8">
            <Grid RowDefinitions="Auto,*" RowSpacing="6">
                <Grid Grid.Row="0"
                      ColumnDefinitions="120,*,120,120,120"
                      Margin="0,0,0,4">
                    <TextBlock Grid.Column="0" Text="Code" FontWeight="SemiBold" Opacity="0.75" />
                    <TextBlock Grid.Column="1" Text="Item" FontWeight="SemiBold" Opacity="0.75" />
                    <TextBlock Grid.Column="2" Text="Category" FontWeight="SemiBold" Opacity="0.75" />
                    <TextBlock Grid.Column="3" Text="Qty" FontWeight="SemiBold" Opacity="0.75" />
                    <TextBlock Grid.Column="4" Text="Supply" FontWeight="SemiBold" Opacity="0.75" />
                </Grid>
                <ScrollViewer Grid.Row="1">
                    <ItemsControl x:Name="StockItemsList">
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
